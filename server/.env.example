# EU-DOC 后端环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 服务端口
PORT=3007

# 数据库路径
DATABASE_PATH=./data/eu-doc.db

# 文件上传目录
UPLOAD_DIR=./uploads

# 公开访问的文件 URL 前缀
PUBLIC_FILE_BASE_URL=http://localhost:3007

# JWT 密钥（生产环境必须修改为强密码）
JWT_SECRET=eu-doc-secret-key-change-in-production

# 应用环境（development / production）
APP_ENV=development

# Resend 邮件服务配置（用于发送验证邮件和密码重置邮件）
RESEND_API_KEY=re_your_api_key
RESEND_FROM=EU-DOC <noreply@auth.example.com>

# 邮件发送频率限制
EMAIL_RATE_LIMIT_COOLDOWN_SECONDS=60
EMAIL_RATE_LIMIT_PER_EMAIL_HOUR=5
EMAIL_RATE_LIMIT_PER_EMAIL_DAY=20
EMAIL_RATE_LIMIT_PER_IP_HOUR=30
EMAIL_RATE_LIMIT_HASH_SECRET=change-to-a-random-secret

# SMTP 兼容配置（当前实现使用 Resend HTTP API，保留用于运维切换）
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key
SMTP_FROM=EU-DOC <noreply@auth.example.com>

# 前端地址（用于生成邮件中的链接）
FRONTEND_URL=http://localhost:5173/eu-doc
